{
    "name": "hcaz/advent-of-code",
    "description": "Advent of Code solutions, built as a static site with Jigsaw.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/collections": "^11.0 || ^12.0 || ^13.0",
        "symfony/yaml": "^6.0 || ^7.0 || ^8.0",
        "tightenco/jigsaw": "^1.8"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "pestphp/pest": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Aoc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "stan": "phpstan analyse",
        "test": "pest",
        "check-leaks": "@php scripts/check-leaks.php",
        "sync-readme": "@php scripts/sync-readme.php",
        "sync-issues": "@php scripts/sync-gitea-issues.php --dry-run"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
