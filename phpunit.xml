<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Solutions">
            <directory>tests/Solutions</directory>
        </testsuite>
    </testsuites>

    <!--
        Solution regression tests need decrypted puzzle inputs, which CI
        deliberately does not have, and some days are brute force. Run them
        locally by passing the group flag to pest: group=solutions
    -->
    <groups>
        <exclude>
            <group>solutions</group>
        </exclude>
    </groups>
</phpunit>
